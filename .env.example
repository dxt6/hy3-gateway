# hy3-gateway 本地运行环境变量模板
#
# 用法：
#   1. 复制本文件为 `.env.local`（该文件已被 .gitignore 忽略，不会上传）：
#        cp .env.example .env.local
#   2. 把下面占位符换成真实值（来自腾讯云 CloudBase 控制台 + 你的网关鉴权 Token）。
#   3. 启动脚本会优先读取 `.env.local`；详见 LOCAL_RUN.md。
#
# 注意：真实凭据（尤其是 CB_SKEY / CB_PROXY_AUTH）保密，切勿提交到公开仓库。

# CloudBase 环境 ID（控制台「环境」页复制，形如 dxt667-xxxxxxxx）
CB_ENV_ID=你的_ENV_ID

# CloudBase 密钥（SecretId / SecretKey，保密）
CB_SID=你的_SECRET_ID
CB_SKEY=你的_SECRET_KEY

# 网关鉴权 Token：客户端请求必须带 `Authorization: Bearer <此值>`。
# 可自定一段随机串；本地与服务器可不同。
CB_PROXY_AUTH=你的_PROXY_AUTH_TOKEN

# 监听地址：本地用 127.0.0.1（仅本机）；需局域网/外网访问改 0.0.0.0（注意安全）。
LISTEN=127.0.0.1

# 单网关最大并发（给 CloudBase 成长计划额度留余量，默认 4）
MAX_CONCURRENCY=4

# ---------- 视觉能力（可选）----------
# 请求带图片时自动路由到视觉模型（OpenAI 兼容 API），纯文本请求仍走 CloudBase hy3。
# 默认指向智谱 GLM-4V-Flash（免费档）：去 https://open.bigmodel.cn 注册拿 API Key 填 VISION_API_KEY 即可。
# 不填 VISION_API_KEY 则视觉路由关闭，行为与旧版完全一致。
VISION_API_KEY=你的_智谱_API_KEY
# VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions   # 默认即可，换供应商才改
# VISION_MODEL=glm-4v-flash                                              # 默认即可；付费可换 glm-4v-plus

# 可选：设置后在 443 终止 TLS（纯 HTTPS）。本地一般留空，用纯 HTTP。
# SSL_CERT=
# SSL_KEY=
